{
  "name": "@ultrathink/ultra-ui-lib",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-contained Ultra UI helpers for generating, linting, diffing, and exporting DESIGN.md files.",
  "bin": {
    "ultra-ui": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit",
    "ultra-ui": "tsx ./index.ts"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22"
  }
}
