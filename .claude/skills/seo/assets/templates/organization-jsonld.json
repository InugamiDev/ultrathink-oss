{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "{{name}}",
  "url": "{{url}}",
  "logo": "{{logoUrl}}",
  "description": "{{description}}",
  "sameAs": [
    "{{twitterUrl}}",
    "{{linkedinUrl}}",
    "{{githubUrl}}"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "{{phone}}",
    "contactType": "customer service",
    "email": "{{email}}",
    "availableLanguage": ["en"]
  }
}
