{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{title}}",
  "description": "{{excerpt}}",
  "image": ["{{coverImage}}"],
  "datePublished": "{{publishedAtIso}}",
  "dateModified": "{{updatedAtIso}}",
  "author": {
    "@type": "Person",
    "name": "{{authorName}}",
    "url": "{{authorUrl}}"
  },
  "publisher": {
    "@type": "Organization",
    "name": "{{siteName}}",
    "logo": { "@type": "ImageObject", "url": "{{siteLogoUrl}}" }
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": "{{canonicalUrl}}" }
}
