# Tauri-generated schemas (regenerated on every build)
apps/studio/src-tauri/gen/

# Studio runtime state
.ultrathink-studio/

# Tauri updater private key — paired with the pubkey in tauri.conf.json.
# If this leaks, anyone can sign malicious "updates" that running apps
# trust. Treat with the same paranoia as a release-signing key.
.tauri-updater.key
*.tauri-updater.key

# CAR per-lane worktrees (created on demand under ~/.ultrathink-studio/worktrees/)
worktrees/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

