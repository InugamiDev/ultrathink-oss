/tmp/
*.tmp
paperclip/server/ui-dist.backup.*/

# Package manager hygiene
package-lock.json
**/package-lock.json
yarn.lock

# Local MCP config may contain command paths and tokens. Commit .mcp.example.json instead.
.mcp.json

