# UltraThink Environment Variables
# Copy to .env and fill in your local values.
# Keep .env untracked; never commit real API keys, webhook URLs, tokens, or DB passwords.

# Required
DATABASE_URL="postgresql://<db_user>:<db_password>@<neon_host>/<db_name>?sslmode=require"

# Optional
DISCORD_WEBHOOK_URL=""
NEXT_PUBLIC_APP_URL=http://localhost:3333
PORT=3333
GROQ_API_KEY=""
ELEVENLABS_API_KEY=""
