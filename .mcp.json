{
  "mcpServers": {
    "vfs": {
      "command": "vfs",
      "args": ["mcp"],
      "env": {}
    },
    "code-intel": {
      "command": "node",
      "args": ["packages/code-intel/dist/mcp-server.js"],
      "env": {}
    },
    "stitch": {
      "command": "npx",
      "args": ["-y", "@google/stitch-mcp"],
      "env": {}
    }
  }
}
