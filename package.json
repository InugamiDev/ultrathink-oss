{
  "name": "ultrathink",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Workflow OS for AI coding agents — skill mesh, persistent memory, privacy hooks, Studio, and observability dashboard",
  "packageManager": "pnpm@10.28.0",
  "workspaces": [
    "packages/*",
    "mcp/*",
    "apps/*",
    "tools/harness",
    "videos"
  ],
  "scripts": {
    "setup": "./scripts/setup.sh",
    "install:global": "./scripts/install.sh",
    "dashboard": "./scripts/dashboard.sh",
    "dashboard:dev": "pnpm --filter @ultrathink/dashboard dev",
    "dashboard:build": "pnpm --filter @ultrathink/dashboard build",
    "doctor": "./scripts/doctor.sh",
    "migrate": "./scripts/migrate.sh",
    "migrate:run": "pnpm --filter @ultrathink/memory migrate",
    "seed": "pnpm --filter @ultrathink/memory seed",
    "compact": "pnpm --filter @ultrathink/memory compact",
    "lint": "eslint .",
    "format": "prettier --write '**/*.{ts,tsx,js}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js}'",
    "test": "vitest run",
    "typecheck": "pnpm --filter @ultrathink/dashboard exec tsc --noEmit",
    "codeintel:build": "pnpm --filter @ultrathink/code-intel build",
    "codeintel:index": "pnpm --filter @ultrathink/code-intel index -- index",
    "harness": "pnpm --filter @ultrathink/harness dev",
    "harness:expert": "pnpm --filter @ultrathink/harness expert",
    "harness:test": "pnpm --filter @ultrathink/harness test",
    "prompts:sync": "node scripts/sync-prompts.mjs --write",
    "prompts:check": "node scripts/sync-prompts.mjs --check",
    "skills:sync-registry": "node scripts/sync-skill-registry.mjs",
    "gemini:auth": "pnpm exec tsx scripts/gemini-browser/auth.ts",
    "gemini:generate": "pnpm exec tsx scripts/gemini-browser/generate.ts"
  },
  "author": "InuVerse",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@eslint/js": "^10.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.0.3",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "postgres": "^3.4.8"
  },
  "pnpm": {
    "overrides": {
      "postgres": "^3.4.8",
      "drizzle-orm": "^0.38.4",
      "zod": "^3.24.2",
      "express": "^5.1.0",
      "better-auth": "1.4.18"
    },
    "onlyBuiltDependencies": [
      "@embedded-postgres/darwin-arm64",
      "esbuild",
      "sharp"
    ]
  }
}
